# PolyPhage AI - Environment Configuration Example
# Copy this file to .env to configure local settings

# Server Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AI BYOK Default Configuration (Optional - can also be configured via Settings UI)
# Provider types: openai, groq, openrouter, custom
AI_PROVIDER=openai
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
